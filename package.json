    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.553.0",
    "mathjs": "^15.2.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.10.1",
