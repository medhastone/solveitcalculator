  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "export": "NODE_ENV=production GITHUB_PAGES=true STATIC_EXPORT=true next build && node scripts/generate-gh-pages-redirects.mjs",
    "start": "next start -p 3000",
